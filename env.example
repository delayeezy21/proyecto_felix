# Plantilla de entorno de la APP (cliente). Nunca subas los archivos reales al repo.
#
# Un archivo por ambiente (todos en .gitignore por la regla `.env` / `.env.*`):
#   .env        → local   (supabase start)
#   .env.beta   → beta    (proyecto Supabase Cloud de beta)
#   .env.prod   → producción
# Uso:
#   flutter run -d chrome --dart-define-from-file=.env
#   flutter build web --release --base-href / --dart-define-from-file=.env.beta
# Antes de compilar beta o producción:
#   node tool/env/validar_env.mjs .env.beta
# En GitHub Actions el archivo se genera desde los secretos del Environment
# (ver .github/workflows/web-deploy.yml); no hace falta subirlo a ningún lado.
#
# Estas claves quedan DENTRO de la app compilada: NO pongas aquí la clave
# secreta/service_role de Supabase, la contraseña de la base, el access token
# de Supabase ni credenciales de FCM (van en los secretos de Supabase o de GitHub).

# local | beta | production  (solo lo usa validar_env.mjs; la app lo ignora)
APP_ENV=local

# Local: http://127.0.0.1:54321 (o la IP de tu PC en la red para el iPhone).
# Nube:  https://<project-ref>.supabase.co  (Dashboard → Project Settings → API).
SUPABASE_URL=http://127.0.0.1:54321
# sb_publishable_... (Dashboard → Project Settings → API Keys). Nunca sb_secret_...
SUPABASE_PUBLISHABLE_KEY=

# Mapas: google | osm. Windows (y por ahora iOS) siempre usan osm; sin
# MAPS_API_KEY también se usa osm. La clave de Google se restringe en Google
# Cloud por app (Android) y por dominio (Web). En Android llega al manifiesto
# desde este mismo archivo (android/app/build.gradle.kts).
MAP_PROVIDER=osm
# Clave de Google Maps restringida por app/dominio (vacía con osm).
MAPS_API_KEY=

# Tiles del mapa OSM ({z}/{x}/{y}). Vacío = tiles públicos de OpenStreetMap,
# solo para desarrollo (su política prohíbe el uso intensivo). En producción:
# Stadia (https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}.png?api_key=...)
# o MapTiler (https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=...).
OSM_TILE_URL=
# Atribución que exige el proveedor de tiles (vacío = OpenStreetMap).
OSM_TILE_ATTRIBUTION=

# Geocoding con OSM (Nominatim). Vacío = servidor público (máx. 1 req/s; la app
# aplica debounce, caché y una cola de 1 s). Es el geocoding por defecto en
# todas las plataformas.
NOMINATIM_URL=

# Opcional, solo Android: clave PROPIA para la API REST de Geocoding de Google.
# No reutilices MAPS_API_KEY: la API REST rechaza (REQUEST_DENIED) las claves
# restringidas a una app Android si la petición no trae las cabeceras
# X-Android-Package y X-Android-Cert. Restringe esta clave por API (solo
# "Geocoding API") y fija una cuota diaria baja en Google Cloud, porque queda
# dentro de la app. Vacío = Nominatim. En Web nunca se usa (sin CORS).
GOOGLE_GEOCODING_API_KEY=

# Login con Google: true solo si [auth.external.google] está habilitado en Supabase.
GOOGLE_AUTH_ENABLED=false
