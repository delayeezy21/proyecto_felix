# Copia este archivo como .env y completa los valores. Nunca subas .env al repo.
# Uso: flutter run --dart-define-from-file=.env
#
# Estas claves quedan dentro de la app compilada: NO pongas aquí la clave
# service_role/secreta de Supabase ni credenciales de FCM (van en los secretos de Supabase).

# Supabase local (supabase start) o del proyecto en la nube.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=

# Mapas: google | osm  (en Windows siempre se usa osm)
MAP_PROVIDER=osm
MAPS_API_KEY=
